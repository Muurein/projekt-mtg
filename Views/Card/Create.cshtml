@model Projekt_mtg.Models.ViewModels.CardAndCollectionVM

@{
    ViewData["Title"] = "Create";
}

<h1>Add Cards</h1>

<hr 

<div class="row">
    <div class="col-md-4 crud-div">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CardName" class="control-label"></label>
                <input asp-for="CardName" class="form-control" />
                <span asp-validation-for="CardName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OwnedQuantity" class="control-label">Owned</label>
                <input asp-for="OwnedQuantity" class="form-control" />
                <span asp-validation-for="OwnedQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WishlistQuantity" class="control-label">Wishlist</label>
                <input asp-for="WishlistQuantity" class="form-control" />
                <span asp-validation-for="WishlistQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InDeckQuantity" class="control-label">In Deck</label>
                <input asp-for="InDeckQuantity" class="form-control" />
                <span asp-validation-for="InDeckQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group button-group">
                <input class="btn btn-primary green-button button" type="submit" value="Create"  />
            </div>
        </form>

        <div class="form-group button-group">
            <a class="general-button button" id="back-button" asp-action="Index">Back to List</a>
        </div>

    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


