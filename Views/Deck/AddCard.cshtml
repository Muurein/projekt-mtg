@{
    ViewData["Title"]="Add Card to Deck";
}

<h1>Add Card to Deck</h1>

<form asp-action="AddCard" method="post">
    <input type="hidden" name="deckId" value="@ViewBag.DeckId"/>

    
    <div class="form-group">
        <label>Card Name</label>
        <br />
        <input class="form-control" name="cardName" />
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <br />
        <input class="form-control" name="quantity" value="1" />
    </div>

    <div class="form-group">
        <label>Commander: </label>
        <input type="checkbox" name="isCommander" value="true" />
    </div>

    <div class="form-group button-group">
        <input class="btn btn-primary green-button button" type="submit" value="Add"  />
    </div>
</form>

<div class="form-group button-group">
    <a class="general-button button" id="back-button" asp-action="Details" asp-route-id="@ViewBag.DeckId">Back to List</a>
</div>