@model Projekt_mtg.Models.Deck

@{
    ViewData["Title"] = "Create";
}

<h1>Create Deck</h1>

<hr />
<div class="row">
    <div class="col-md-4 crud-div">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Format" class="control-label"></label>
                <select asp-for="Format" class="form-control">
                    <option value="Commander">Commander</option>
                    <option value="Standard">Standard</option>
                </select>
                <span asp-validation-for="Format" class="text-danger"></span>
            </div>
            <div class="form-group button-group">
                <input class="btn btn-primary green-button button" type="submit" value="Create"  />
            </div>
        </form>

        <div class="form-group button-group">
            <a class="general-button button" id="back-button" asp-action="Index">Back to List</a>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
