@model IEnumerable<Projekt_mtg.Models.Deck>

@{
    ViewData["Title"] = "Decks";
}


<main class="main-cards">
    <h1>My Decks</h1>

    <div class="button-group">
        <a class="green-button add-deck-button button" asp-action="Create">Create a Deck</a>
    </div>
    

    <div class="gridbox">

        @foreach (var item in Model)
        {
            <article>
                <div class="card-info">
                    
                    <a class="card-name" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>

                    <div class="card-buttons">
                        <a class="add-deck-card-button update-button button" asp-action="Details" asp-route-id="@item.Id">View</a>
                        <a class="update-button button" asp-action="Edit" asp-route-id="@item.Id">Update</a>
                        <a class="remove-button button" asp-action="Delete" asp-route-id="@item.Id">Remove</a>
                    </div>
                </div>
            </article>
        }
    </div>
</main>
