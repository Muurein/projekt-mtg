@model Projekt_mtg.Models.Deck

@{
    ViewData["Title"] = "Deck Details";
}

<main>
    <h1>Add Card to Deck</h1>

    <div class="deck-info">
        <h2>@Model.Name</h2>
        <p><strong>@Model.Format</strong></p>
        <a class="green-button button add-deck-card-button" asp-action="AddCard" asp-route-deckId="@Model.Id">Add Card</a>
        <div class="form-group button-group">
            <a class="general-button button" id="back-button" asp-action="Index">Back to List</a>
        </div>
    </div>

    <div class="search-field">
        <form method="get">
            <input type="hidden" name="id" value="@Model.Id" />
            
            <label for="searchString">Search amongst the cards in your deck:</label>
            <br />
            <input class="form-input" type="text" id="searchString" name="searchString" />
            <br />
            <button class="general-button button crud-button" id="search-button" type="submit">Search</button>
        </form>
    </div>

    <div class="gridbox">
        @foreach(var item in Model.DeckCards)
        {
            <article class="@(item.IsCommander ? "commander-card" : "")">

                <div class="card-name-div">
                    <img class="card-image" src="@item.Card.ImageUri" alt="@item.Card.Name" />
                </div>

                <div class="card-info">
                    <p class="card-name">@item.Card.Name</p>
                    <p>Quantity: @item.Quantity</p>

                    @if(item.IsCommander)
                    {
                        <p>Commander</p>
                    }
                </div>

                <div class="card-buttons">
                    <form asp-action="RemoveCard" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                            name="deckCardId"
                            value="@item.Id" />

                        <button class="remove-button button" type="submit">Remove</button>
                    </form>
                </div>
            </article>
        }
    </div>
</main>
