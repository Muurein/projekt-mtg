@model Projekt_mtg.Models.Collection

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Collection</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group hidden-input">
                <label asp-for="CardId" class="control-label"></label>
                <input asp-for="CardId" type="hidden" class="form-control" />
                <span asp-validation-for="CardId" class="text-danger"></span>
            </div> 
            <div class="form-group hidden-input">
                <label asp-for="UserId" class="control-label"></label>
                <input asp-for="UserId" type="hidden" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OwnedQuantity" class="control-label">Owned</label>
                <input asp-for="OwnedQuantity" class="form-control" />
                <span asp-validation-for="OwnedQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WishlistQuantity" class="control-label">Wishlist</label>
                <input asp-for="WishlistQuantity" class="form-control" />
                <span asp-validation-for="WishlistQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InDeckQuantity" class="control-label">In Deck</label>
                <input asp-for="InDeckQuantity" class="form-control" />
                <span asp-validation-for="InDeckQuantity"" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input class="btn btn-primary green-button button" type="submit" value="Save" />
            </div>
        </form>
    </div>
</div>

<div class="form-group">
    <a class="general-button button back-button" asp-action="Index">Back to your collection</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
