@using System.Reflection
@model IEnumerable<Projekt_mtg.Models.Collection>

@{
    ViewData["Title"] = "Wishlist";
}

<h1>Wishlist</h1>

<div class="search-field">
    <form method="get">
        <label for="searchString">Search:</label>
        <br />
        <input class="form-input" type="text" id="searchString" name="searchString" />
        <br />
        <button class="general-button button crud-button" id="search-button" type="submit">Search</button>
    </form>
</div>

<div class="gridbox">

    @foreach (var item in Model)
    {
        <article>
            <div class="card-name-div">
                @if(item.Card != null) {
                    <img class="card-image" src="@item.Card.ImageUri" alt="@item.Card.Name" />
                }
            </div>
            

            <div class="card-info">
                <p class="card-name">@item.Card.Name</p>

                <p>Quantity: @item.WishlistQuantity</p>

                <div class="card-buttons">
                    <a class="update-button button" asp-action="Edit" asp-route-id="@item.Id">Update</a>
                    <a class="remove-button button" asp-action="Delete" asp-route-id="@item.Id">Remove</a>
                </div>
            </div>
        </article>
    }
</div>