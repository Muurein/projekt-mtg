@model IEnumerable<Projekt_mtg.DTOs.CardDto>

@{
    ViewData["Title"] = "Home Page";
}

<main class="main-cards">
    <h1>HOARDER</h1>
    <p class="intro">Here at HOARDER you can browse cards from <i>Magic: the Gathering</i>!</p>
    <p clasS="intro">By creating an account you can access features such as keeping track of the cards in your collection, your decks and the cards on your wishlist.</p>

    <!--lets the user search for cards in Scryfall's database-->
    <div class="search-field">
        <form method="get">
            <label for="searchString">Search:</label>
            <br />
            <input class="form-input" type="text" id="searchString" name="searchString" />
            <br />
            <button class="general-button button crud-button" id="search-button" type="submit">Search</button>
        </form>
    </div>

    <!--writes out the cards in a grid, only showing their images and names-->
    <div class="gridbox">

        @if(!Model.Any())
        {
            <p>No cards found</p>
        }

        @foreach (var item in Model)
        {
            <article>
                <div class="card-name-div">
                    <img class="card-image" src="@item.ImageUri" alt="@item.Name" />
                </div>

                <div class="card-info">
                    <p class="card-name">@item.Name</p>
                </div>
            </article>
        }
    </div>
</main>



